{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipStack",
  "version": "0.4.0",
  "identifier": "com.fradone.clipstack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQUM4MDIyRDlGOThCNjUKUldSbGkvblpJb0NzcldSKzNEczRzcTMwZjFVWURLK2kvNVhaOHIvSldhWWVYbllhTEluT0NadSsK",
      "endpoints": [
        "https://github.com/francescodone/clipstack/releases/latest/download/latest.json"
      ]
    }
  }
}
